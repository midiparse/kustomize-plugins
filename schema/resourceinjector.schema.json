{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResourceInjector",
  "description": "Function configuration for the ResourceInjector kustomize plugin. It renders a kustomize source and injects the resulting YAML into fields of selected resources.",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "kustomize-plugins.midiparse.github.com/v1alpha1"
    },
    "kind": {
      "const": "ResourceInjector"
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "spec": {
      "type": "object",
      "required": ["source", "targets"],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "object",
          "required": ["path"],
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "description": "Path to a kustomization directory or a YAML file, relative to the kustomization that includes the plugin."
            },
            "fieldPath": {
              "type": "string",
              "description": "Optional field path to project from the rendered source."
            },
            "options": {
              "type": "object",
              "description": "Kustomize build options applied when rendering the source directory.",
              "additionalProperties": false,
              "properties": {
                "reorder": {
                  "type": "string",
                  "enum": ["legacy", "none", "unspecified"],
                  "description": "Order in which resources are emitted."
                },
                "addManagedByLabel": {
                  "type": "boolean",
                  "description": "Add an app.kubernetes.io/managed-by label to all rendered resources."
                },
                "loadRestrictions": {
                  "type": "string",
                  "enum": ["none", "rootOnly", "unknown"],
                  "description": "Restrictions on where files can be loaded from while rendering the source."
                },
                "pluginConfig": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "pluginRestrictions": {
                      "type": "string",
                      "enum": ["none", "builtinsOnly", "unknown"],
                      "description": "Plugins allowed while rendering the source."
                    },
                    "fnpLoadingOptions": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "enableExec": {
                          "type": "boolean",
                          "description": "Allow exec-based function plugins while rendering the source."
                        }
                      }
                    },
                    "helmConfig": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "enabled": {
                          "type": "boolean",
                          "description": "Enable Helm chart rendering while rendering the source."
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/target"
          }
        }
      }
    }
  },
  "$defs": {
    "metadata": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "namespace": {
          "type": "string"
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "selector": {
      "type": "object",
      "description": "Selects target resources by group, version, kind, name, namespace, labels, or annotations.",
      "additionalProperties": false,
      "properties": {
        "group": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "namespace": {
          "type": "string"
        },
        "annotationSelector": {
          "type": "string"
        },
        "labelSelector": {
          "type": "string"
        }
      }
    },
    "fieldOptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean",
          "description": "Create the field if it does not exist."
        }
      }
    },
    "target": {
      "type": "object",
      "required": ["select"],
      "additionalProperties": false,
      "properties": {
        "select": {
          "$ref": "#/$defs/selector"
        },
        "fieldPaths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "options": {
          "$ref": "#/$defs/fieldOptions"
        }
      }
    }
  }
}
